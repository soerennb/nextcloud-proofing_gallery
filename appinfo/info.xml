<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>proofing_gallery</id>
	<name>Proofing Gallery</name>
	<summary>Branded client galleries and collaborative photo proofing</summary>
	<description><![CDATA[
Publish existing Nextcloud folders as customizable client galleries.
Collect likes, workflow states, comments, annotations, and named selections
without copying or changing original files.
	]]></description>
	<version>0.5.1</version>
	<licence>AGPL-3.0-or-later</licence>
	<author>soerennb</author>
	<namespace>ProofingGallery</namespace>
	<category>files</category>
	<category>multimedia</category>
	<website>https://soerennb.github.io/nextcloud-proofing_gallery/</website>
	<bugs>https://github.com/soerennb/nextcloud-proofing_gallery/issues</bugs>
	<repository>https://github.com/soerennb/nextcloud-proofing_gallery</repository>
	<discussion>https://github.com/soerennb/nextcloud-proofing_gallery/discussions</discussion>
	<documentation>
		<user>https://soerennb.github.io/nextcloud-proofing_gallery/en/user-guide/</user>
		<admin>https://soerennb.github.io/nextcloud-proofing_gallery/en/admin-guide/</admin>
		<developer>https://soerennb.github.io/nextcloud-proofing_gallery/en/development/</developer>
	</documentation>
	<screenshot>https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/owner-dashboard.png</screenshot>
	<screenshot>https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/public-gallery.png</screenshot>
	<dependencies>
		<php min-version="8.1" max-version="8.6"/>
		<database>sqlite</database>
		<database>mysql</database>
		<database>pgsql</database>
		<nextcloud min-version="31" max-version="34"/>
	</dependencies>
	<navigations>
		<navigation>
			<id>proofing_gallery</id>
			<name>Proofing Gallery</name>
			<route>proofing_gallery.page.index</route>
			<icon>app.svg</icon>
			<order>10</order>
			<type>link</type>
		</navigation>
	</navigations>
	<activity>
		<settings>
			<setting>OCA\ProofingGallery\Activity\Setting</setting>
		</settings>
		<providers>
			<provider>OCA\ProofingGallery\Activity\Provider</provider>
		</providers>
	</activity>
	<settings>
		<admin-section>OCA\ProofingGallery\Settings\AdminSection</admin-section>
		<admin>OCA\ProofingGallery\Settings\Admin</admin>
		<personal>OCA\ProofingGallery\Settings\Personal</personal>
	</settings>
</info>
