<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>proofing_gallery</id>
	<name lang="en">Proofing Gallery</name>
	<name lang="de">Proofing Gallery – Kundengalerien</name>
	<summary lang="en">Branded client galleries and collaborative photo proofing</summary>
	<summary lang="de">Moderne Kundengalerien für Bildauswahl, Feedback und Freigabe</summary>
	<description lang="en"><![CDATA[
Publish existing Nextcloud folders as customizable client galleries.
Collect likes, workflow states, comments, annotations, and named selections
without copying or changing original files.
	]]></description>
	<description lang="de"><![CDATA[
Veröffentliche vorhandene Nextcloud-Ordner als individuell gestaltbare
Kundengalerien. Sammle Favoriten, Bearbeitungsstände, Kommentare, Anmerkungen
und benannte Auswahlen, ohne Originaldateien zu kopieren oder zu verändern.
	]]></description>
	<version>0.8.1</version>
	<licence>AGPL-3.0-or-later</licence>
	<author>soerennb</author>
	<namespace>ProofingGallery</namespace>
	<category>files</category>
	<category>multimedia</category>
	<website>https://soerennb.github.io/nextcloud-proofing_gallery/</website>
	<bugs>https://github.com/soerennb/nextcloud-proofing_gallery/issues</bugs>
	<repository>https://github.com/soerennb/nextcloud-proofing_gallery</repository>
	<discussion>https://github.com/soerennb/nextcloud-proofing_gallery/discussions</discussion>
	<documentation>
		<user>https://soerennb.github.io/nextcloud-proofing_gallery/en/user-guide/</user>
		<admin>https://soerennb.github.io/nextcloud-proofing_gallery/en/admin-guide/</admin>
		<developer>https://soerennb.github.io/nextcloud-proofing_gallery/en/development/</developer>
	</documentation>
	<screenshot small-thumbnail="https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/public-showcase-desktop-small.png">https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/public-showcase-desktop.png</screenshot>
	<screenshot small-thumbnail="https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/public-lightbox-desktop-small.png">https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/public-lightbox-desktop.png</screenshot>
	<screenshot small-thumbnail="https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/culling-focus-desktop-small.png">https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/culling-focus-desktop.png</screenshot>
	<screenshot small-thumbnail="https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/design-studio-desktop-small.png">https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/design-studio-desktop.png</screenshot>
	<screenshot small-thumbnail="https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/owner-dashboard-desktop-small.png">https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/owner-dashboard-desktop.png</screenshot>
	<screenshot small-thumbnail="https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/public-showcase-mobile-small.png">https://soerennb.github.io/nextcloud-proofing_gallery/screenshots/public-showcase-mobile.png</screenshot>
	<dependencies>
		<php min-version="8.1" max-version="8.6"/>
		<database>sqlite</database>
		<database>mysql</database>
		<database>pgsql</database>
		<nextcloud min-version="31" max-version="34"/>
	</dependencies>
	<navigations>
		<navigation>
			<id>proofing_gallery</id>
			<name>Proofing Gallery</name>
			<route>proofing_gallery.page.index</route>
			<icon>app.svg</icon>
			<order>10</order>
			<type>link</type>
		</navigation>
	</navigations>
	<activity>
		<settings>
			<setting>OCA\ProofingGallery\Activity\Setting</setting>
		</settings>
		<providers>
			<provider>OCA\ProofingGallery\Activity\Provider</provider>
		</providers>
	</activity>
	<openmetrics>
		<exporter>OCA\ProofingGallery\OpenMetrics\GalleryTotalMetric</exporter>
		<exporter>OCA\ProofingGallery\OpenMetrics\BacklogMetric</exporter>
		<exporter>OCA\ProofingGallery\OpenMetrics\IntegrationOutboxMetric</exporter>
		<exporter>OCA\ProofingGallery\OpenMetrics\CleanupSuccessMetric</exporter>
		<exporter>OCA\ProofingGallery\OpenMetrics\DerivativeBytesMetric</exporter>
	</openmetrics>
	<background-jobs>
		<job>OCA\ProofingGallery\BackgroundJob\PurgeGuestsJob</job>
		<job>OCA\ProofingGallery\BackgroundJob\CleanupGalleryDataJob</job>
		<job>OCA\ProofingGallery\BackgroundJob\SendNotificationDigestsJob</job>
		<job>OCA\ProofingGallery\BackgroundJob\RevalidateCustomDomainsJob</job>
		<job>OCA\ProofingGallery\BackgroundJob\DispatchIntegrationOutboxJob</job>
		<job>OCA\ProofingGallery\BackgroundJob\ProcessPurgeRequestsJob</job>
	</background-jobs>
	<repair-steps>
		<install>
			<step>OCA\ProofingGallery\RepairStep\InitFilesMetadata</step>
			<step>OCA\ProofingGallery\RepairStep\NormalizeBackgroundJobs</step>
			<step>OCA\ProofingGallery\RepairStep\ScheduleProjectionBackfills</step>
		</install>
		<post-migration>
			<step>OCA\ProofingGallery\RepairStep\InitFilesMetadata</step>
			<step>OCA\ProofingGallery\RepairStep\NormalizeBackgroundJobs</step>
			<step>OCA\ProofingGallery\RepairStep\ScheduleProjectionBackfills</step>
		</post-migration>
	</repair-steps>
	<settings>
		<admin-section>OCA\ProofingGallery\Settings\AdminSection</admin-section>
		<admin>OCA\ProofingGallery\Settings\Admin</admin>
		<personal>OCA\ProofingGallery\Settings\Personal</personal>
	</settings>
</info>
