COMPOSE_PROJECT_NAME=proofing-gallery
# Optional: on-failure keeps the stack manual-start across Docker/WSL restarts.
COMPOSE_RESTART_POLICY=unless-stopped
NEXTCLOUD_PORT=8080
MAILPIT_PORT=8026
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=admin
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=nextcloud
MYSQL_ROOT_PASSWORD=nextcloud-root
