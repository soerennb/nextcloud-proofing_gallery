{
  "name": "proofing_gallery",
  "version": "0.12.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "preflight": "node scripts/check-node-version.mjs && npm run test:dependencies",
    "audit:dependencies": "node scripts/audit-npm.mjs",
    "prebuild": "npm run preflight && node scripts/clean-build.mjs",
    "build": "vite build",
    "build:docs": "node scripts/build-docs-site.mjs",
    "postbuild": "node scripts/check-bundle-size.mjs",
    "build:l10n": "node scripts/build-l10n.mjs --write",
    "check:l10n": "node scripts/build-l10n.mjs --check",
    "check:source-size": "node scripts/check-source-size.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "dev": "vite --mode development build",
    "lint": "npm run preflight && npm run check:l10n && npm run check:source-size && npm run check:docs && npm run lint:js && npm run lint:style && npm run typecheck",
    "lint:js": "eslint src --max-warnings=0",
    "lint:style": "stylelint \"src/**/*.{vue,css,scss}\"",
    "perf:public": "node scripts/measure-public-lcp.mjs",
    "test": "npm run preflight && vitest run && node --test scripts/lib/*.test.mjs",
    "test:e2e": "npm run preflight && node scripts/run-e2e.mjs",
    "test:e2e:raw": "playwright test",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "watch": "vite --mode development build --watch",
    "test:dependencies": "node scripts/check-guarded-braces.mjs"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "overrides": {
    "@nextcloud/vite-config": {
      "vite-plugin-dts": "5.1.2"
    },
    "webdav": {
      "minimatch": "10.2.6"
    },
    "braces": "$braces"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@ionic/core": "^9.0.9",
    "@ionic/vue": "^9.0.9",
    "@mdi/js": "^7.4.47",
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/dialogs": "^7.5.0",
    "@nextcloud/event-bus": "^3.3.3",
    "@nextcloud/files": "^4.1.1",
    "@nextcloud/files-legacy": "npm:@nextcloud/files@^3.13.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.3.0",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.14.0",
    "@tanstack/vue-virtual": "^3.13.48",
    "ionicons": "^8.1.0",
    "motion-v": "^2.8.0",
    "photoswipe": "^5.4.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-material-design-icons": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@dieub/braces-depth-guard": "file:tooling/vendor/braces-depth-guard-3.0.3-pn.3.tgz",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.1.1",
    "@nextcloud/vite-config": "^2.5.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "braces": "file:tooling/braces-compat",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "magic-string": "^1.4.3",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "stylelint": "^17.16.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^24.22.1",
    "npm": "^11.3.0"
  }
}
